{
  "$schema": "https://developers.cloudflare.com/workers/wrangler/config-schema.json",
  "name": "finanztracker-pro",
  "main": "_worker.js",
  "compatibility_date": "2026-09-18",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "single-page-application"
  }
}
